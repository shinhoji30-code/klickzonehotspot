create table public.inventory_records (
  id bigint generated by default as identity primary key,
  receipt_date date not null default current_date,
  supplier text,
  details text not null,
  amount numeric(12,2) not null default 0,
  receipt_photo text,
  created_at timestamp with time zone not null default now()
);

alter table public.inventory_records enable row level security;

create policy "Allow public read inventory"
on public.inventory_records
for select
to anon
using (true);

create policy "Allow public insert inventory"
on public.inventory_records
for insert
to anon
with check (true);

create policy "Allow public update inventory"
on public.inventory_records
for update
to anon
using (true)
with check (true);

create policy "Allow public delete inventory"
on public.inventory_records
for delete
to anon
using (true);
